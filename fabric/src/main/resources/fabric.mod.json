{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": ${description_json},
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/jungdabs-turrets",
        "sources": "https://github.com/Jungdab/JungdabsTurrets"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "me.jungdab.jdturrets.FabricJdTurrets"
        ],
        "client": [
          "me.jungdab.jdturrets.FabricJdTurretsClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "geckolib": ">=${geckolib_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
